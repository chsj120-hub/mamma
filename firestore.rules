rules_version = '2';

// 사용자 데이터는 본인만 읽고 쓸 수 있다. 그 밖의 모든 경로는 막는다.
//  users/{uid}            가입 기록 (이 문서가 있어야 '가입된 계정'), 약관 동의 기록(consent)
//  users/{uid}/data/{키}   그 사용자의 앱 데이터 (JSON 문자열)
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 가족 공유: 이 가족 기록(users/{uid})의 구성원인지 (초대 코드로 참여한 사람)
    function isMember(uid) {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // 가입: 처음 한 번, 가입 완료 전(onboarded=false) 상태로만 만들 수 있다
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['provider', 'onboarded', 'createdAt'])
        && request.resource.data.provider in ['google', 'kakao']
        && request.resource.data.onboarded == false;

      // 두 가지 수정만 허용한다
      //  1) 아기 정보 입력을 마치면 onboarded를 false → true로 한 번만 바꾼다
      //  2) 약관·방침 동의 기록(consent)을 남기거나 새 버전으로 갱신한다
      allow update: if isOwner(uid)
        && (
          (
            resource.data.onboarded == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboarded'])
            && request.resource.data.onboarded == true
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent'])
            && request.resource.data.consent.keys().hasOnly(['terms', 'privacy', 'sensitive', 'at'])
            && request.resource.data.consent.terms is string
            && request.resource.data.consent.privacy is string
            && request.resource.data.consent.sensitive is string
            && request.resource.data.consent.at is string
          )
          || (
            // 가족 기록에 참여하거나(구성원으로 등록된 뒤) 내 기록으로 돌아온다
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId'])
            && request.resource.data.householdId is string
            && (
              request.resource.data.householdId == uid
              || exists(/databases/$(database)/documents/users/$(request.resource.data.householdId)/members/$(uid))
            )
          )
        );

      // 회원 탈퇴: 본인 가입 기록과 데이터를 지울 수 있다
      allow delete: if isOwner(uid);

      // 가족 구성원 목록: 주인이 보고 내보낼 수 있고, 구성원 본인은 자기 항목을 보고 나갈 수 있다.
      // 만들 때는 유효한(만료 전) 초대 코드가 있어야 한다
      match /members/{memberId} {
        allow read: if isOwner(uid) || isOwner(memberId);
        allow create: if isOwner(memberId)
          && request.resource.data.keys().hasOnly(['code', 'joinedAt', 'name'])
          && request.resource.data.code is string
          && request.resource.data.joinedAt is string
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.owner == uid
          && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.expiresAt > request.time;
        allow delete: if isOwner(uid) || isOwner(memberId);
      }

      match /data/{key} {
        allow read: if isOwner(uid) || isMember(uid);
        // 가입 기록이 있는 가족 기록에만, 허용된 키만, 값은 JSON 문자열(900KB 미만)
        allow create, update: if (isOwner(uid) || isMember(uid))
          && exists(/databases/$(database)/documents/users/$(uid))
          && key in ['profile', 'mealPlans', 'cubes', 'reactions', 'milestones', 'growth']
          && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 900000;
        allow delete: if isOwner(uid);
      }
    }

    // 접속일 기록(활성 가구 측정): 로그인한 사용자가 자기 가구의 오늘 기록 한 건만 새로 쓸 수 있고 읽을 수 없다.
    // expireAt에 Firestore TTL 정책을 걸어 90일 뒤 자동 삭제한다 (docs/ANALYTICS.md)
    match /activity/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['d', 'h', 'expireAt'])
        && request.resource.data.d is string && request.resource.data.d.size() == 10
        && request.resource.data.h is string
        && id == request.resource.data.d + '_' + request.resource.data.h
        && request.resource.data.expireAt is timestamp
        && (isOwner(request.resource.data.h) || isMember(request.resource.data.h));
    }

    // 가족 초대 코드: 코드를 아는 로그인 사용자만 하나씩 읽을 수 있다(목록 조회 금지). 만든 사람만 지운다. 최대 7일
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.size() >= 8 && code.size() <= 20
        && request.resource.data.keys().hasOnly(['owner', 'expiresAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // 문의·오류 신고: 로그인한 사용자가 새 글만 쓸 수 있고 읽을 수 없다 (운영자는 Firebase 콘솔에서 본다)
    match /feedback/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['kind', 'message', 'contact', 'path', 'ua', 'at'])
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 200
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.at is string;
    }

    match /errors/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['message', 'stack', 'path', 'ua', 'mode', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 3000
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.mode is string && request.resource.data.mode.size() <= 20
        && request.resource.data.at is string;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
