# Firebase 웹 앱 설정값 (Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정)
# 복사해서 .env.local 로 저장하고 값을 채우세요. (.env.local 은 git에 올라가지 않아요)
# 값이 비어 있으면 로그인·서버 저장 기능이 꺼지고 이 기기에만 저장돼요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# (선택) Cloudflare Web Analytics 토큰(방문 분석, 쿠키 없음). docs/ANALYTICS.md
VITE_CF_ANALYTICS_TOKEN=

# (선택) App Check reCAPTCHA v3 사이트 키. 콘솔 → App Check에서 웹 앱을 등록하고 받은 키.
# 키를 넣고 콘솔에서 Firestore '시행'을 켜면 내 사이트가 아닌 곳의 서버 호출이 막혀요. docs/FIREBASE_SETUP.md
VITE_FIREBASE_APPCHECK_KEY=
# 키 종류: enterprise(기본, reCAPTCHA Enterprise) 또는 v3. 비워 두면 enterprise
VITE_FIREBASE_APPCHECK_PROVIDER=
